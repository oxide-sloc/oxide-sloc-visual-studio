<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="OxideSloc.9f3a1c2e-5b6d-4e7f-9a0b-1c2d3e4f5a6b" Version="0.1.0" Language="en-US" Publisher="oxide-sloc" />
    <DisplayName>oxide-sloc</DisplayName>
    <Description xml:space="preserve">Run oxide-sloc code-metrics reports from Visual Studio: analyze the solution or a selected item, view the HTML report, and see SLOC in a tool window.</Description>
    <MoreInfo>https://github.com/oxide-sloc/oxide-sloc</MoreInfo>
    <Icon>Resources\OxideSloc.png</Icon>
    <Tags>sloc, lines of code, code metrics, coverage, oxide-sloc</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,18.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.7.2,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,18.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
  </Assets>
</PackageManifest>
